APP_NAME=Loom
APP_ENV=production
DB_NAME=loom
DB_USER=loom
DB_PASS=change_me
DB_ROOT_PASS=change_root_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400
ALLOWED_ORIGINS=http://localhost:8080,https://loom.dock
FRONTEND_PORT=8080
BACKEND_PORT=8081

# Paramètres pour le développement local avec HTTPS non comentés par défaut. Voir README.md pour plus d'informations.
# COMPOSE_PATH_SEPARATOR=;
# COMPOSE_FILE=docker-compose.yml;docker-compose.ssl.yml
# HTTP_PORT=80
# HTTPS_PORT=443
